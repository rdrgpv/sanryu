PORT=4000
JWT_SECRET=troque_por_uma_chave_secreta_forte
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=troque_esta_senha

# Opcionais: se preenchidas antes do primeiro "npm run seed", pré-populam a
# credencial fixa do Gatame (GATAME_URL/GATAME_EMAIL/GATAME_SENHA) na tabela
# de Configurações. Depois disso, edite/atualize pela tela /admin/configuracoes.
GATAME_API_URL=https://SEU-SITE.com.br/wp-json/mjj/v1/aluno
GATAME_EMAIL=professor@sanryu.com.br
GATAME_SENHA=troque_esta_senha

# Idem, mas para o Access Token do Mercado Pago (usado para gerar cobranças Pix rastreáveis
# e permitir o botão "Verificar pagamento" no admin). Sem ele, o sistema usa o QR Pix estático
# gerado a partir da chave cadastrada em /admin/bancos.
MP_ACCESS_TOKEN=
