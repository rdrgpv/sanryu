# SPA (React Router): qualquer rota que não seja um arquivo/pasta real cai no index.html,
# senão o Apache retorna 404 ao abrir um link direto como /eventos/5 (fora da navegação da SPA).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Página de um evento: passa pelo evento.php, que põe título, descrição e banner do evento na
  # prévia do link (WhatsApp/Instagram não rodam o React). Pra quem abre, é a mesma página.
  RewriteRule ^eventos/([A-Za-z0-9-]+)/?$ evento.php?slug=$1 [L,QSA]

  RewriteRule ^ index.html [L]
</IfModule>
